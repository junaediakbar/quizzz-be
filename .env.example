# Server Configuration
PORT=8080
ENV=development

# Database Configuration (Neon PostgreSQL)
# PgBouncer/Neon pooler: the app appends binary_parameters=yes for lib/pq (see internal/database/db.go).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# AI question parser — pick ONE provider (or set AI_PARSER_PROVIDER=auto)
# auto: uses GEMINI_API_KEY if set, otherwise ZAI_API_KEY (Zhipu GLM / BigModel).
#
# Zhipu / Z.AI-style (BigModel): key format id.secret → JWT auth to chat completions
ZAI_API_KEY=
AI_PARSER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_PARSER_MODEL=glm-3-turbo
#
# Google Gemini (OpenAI-compatible endpoint at Google AI Studio)
# https://ai.google.dev/gemini-api/docs/openai
GEMINI_API_KEY=
# When using Gemini, you can override base/model (optional):
# AI_PARSER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_PARSER_MODEL=gemini-2.0-flash
#
# Force provider: zhipu | gemini | auto
AI_PARSER_PROVIDER=auto
#
# Parser gambar (multimodal): default model = AI_PARSER_MODEL untuk Gemini;
# untuk Zhipu tanpa override, dipakai glm-4-flash. Set manual bila perlu:
# AI_PARSER_VISION_MODEL=gemini-2.0-flash
# AI_PARSER_VISION_MODEL=glm-4-flash

# Cloudinary (optional — required for POST /api/v1/media/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix in Cloudinary (default quizzz/questions)
CLOUDINARY_FOLDER=
# Max multipart upload size in MB (handler uses MAX_UPLOAD_MB; Fiber body limit should match)
MAX_UPLOAD_MB=10

# File Upload Configuration (legacy / local)
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

# Demo data (after migrations): from backend/ run `go run ./cmd/seed`
# Accounts printed to stdout — password password123 for all demo users @seed.quizzz.dev
